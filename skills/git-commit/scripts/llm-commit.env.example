# llm-commit 外部模型配置模板
#
# 用法：复制本文件为同目录的 llm-commit.env 并填写（llm-commit.env 已被 .gitignore 忽略，不会入库）。
# 三项（BASE_URL / MODEL / API_KEY）齐全才会启用外部模型生成；
# 缺任何一项时 git-commit skill 自动回退用 Claude Code 自带模型生成。
# shell 环境变量优先于本文件中的同名配置。
# 默认接 OpenAI 兼容（/chat/completions）服务；Anthropic Messages 格式服务
# （如火山方舟 coding 端点）需额外声明 COMMIT_LLM_API_FORMAT=anthropic。

# --- 火山方舟 Ark coding 端点（Anthropic Messages 格式） ---
# COMMIT_LLM_BASE_URL=https://ark.cn-beijing.volces.com/api/coding
# COMMIT_LLM_MODEL=minimax-m3
# COMMIT_LLM_API_KEY=ark-your-key-here
# COMMIT_LLM_API_FORMAT=anthropic

# --- DeepSeek ---
COMMIT_LLM_BASE_URL=https://api.deepseek.com
COMMIT_LLM_MODEL=deepseek-chat
COMMIT_LLM_API_KEY=sk-your-key-here

# --- MiniMax ---
# COMMIT_LLM_BASE_URL=https://api.minimaxi.com/v1
# COMMIT_LLM_MODEL=MiniMax-Text-01
# COMMIT_LLM_API_KEY=your-key-here

# --- 智谱 GLM ---
# COMMIT_LLM_BASE_URL=https://open.bigmodel.cn/api/paas/v4
# COMMIT_LLM_MODEL=glm-4-flash
# COMMIT_LLM_API_KEY=your-key-here

# --- Google Gemini（OpenAI 兼容端点） ---
# COMMIT_LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
# COMMIT_LLM_MODEL=gemini-2.5-flash
# COMMIT_LLM_API_KEY=your-key-here

# --- 可选项 ---
# COMMIT_LLM_API_FORMAT=openai # API 格式：openai（默认）或 anthropic
# COMMIT_LLM_TIMEOUT=30        # API 总超时（秒）
# COMMIT_LLM_MAX_DIFF_KB=100   # diff 超过该大小降级为 stat 模式
# COMMIT_LLM_SKIP_SCAN=1       # 跳过外发前的密钥扫描（不建议）
