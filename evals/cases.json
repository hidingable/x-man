{
  "fixture": "shop",
  "cases": [
    {
      "id": "flow-explore",
      "title": "探索型需求：方向未定，不应直接写代码",
      "agent": "xman-flow",
      "prompt": "订单列表想加个导出 Excel 的功能，这个需求我还没想清楚怎么做，帮我走一遍完整流程",
      "expect_skills": [
        "brainstorm"
      ],
      "checks": [
        {
          "type": "no_source_change"
        },
        {
          "type": "no_commit"
        }
      ]
    },
    {
      "id": "flow-simple",
      "title": "简单任务：短流程完成，结果正确",
      "agent": "xman-flow",
      "prompt": "价格展示要加千分位，比如 1234567.5 显示成 ¥1,234,567.50，负数照旧把符号放在 ¥ 前面。简单改一下就行",
      "expect_skills": [],
      "checks": [
        {
          "type": "hidden_tests",
          "file": "price-thousands.test.js"
        },
        {
          "type": "visible_tests"
        },
        {
          "type": "no_commit"
        }
      ]
    },
    {
      "id": "flow-analyze-only",
      "title": "只分析：不改代码、不提交",
      "agent": "xman-flow",
      "prompt": "订单列表要能按状态筛选。先帮我分析下要改哪些地方、有什么风险，不要动代码",
      "expect_skills": [
        "req-analyze"
      ],
      "checks": [
        {
          "type": "no_source_change"
        },
        {
          "type": "no_commit"
        }
      ]
    },
    {
      "id": "no-auto-trigger",
      "title": "随口一问：不应自动调用产出文档的 skill",
      "prompt": "订单列表要能按状态筛选，这个大概要改哪些地方？",
      "expect_skills": [],
      "checks": [
        {
          "type": "skills_not_used",
          "skills": [
            "brainstorm",
            "req-analyze",
            "prd",
            "design",
            "create-plan",
            "code-by-plan"
          ]
        },
        {
          "type": "no_source_change"
        },
        {
          "type": "no_commit"
        }
      ]
    },
    {
      "id": "flow-resume",
      "title": "续接已有分析和计划：从实施继续",
      "agent": "xman-flow",
      "overlays": [
        {
          "name": "order-filter-analysis",
          "mode": "base"
        },
        {
          "name": "order-filter-plan",
          "mode": "base"
        }
      ],
      "prompt": "订单状态筛选的需求分析和编码计划都写完了，在 .ai-configs 里。继续往下推进，把它做完",
      "expect_skills": [
        "code-by-plan"
      ],
      "checks": [
        {
          "type": "hidden_tests",
          "file": "order-filter.test.js"
        },
        {
          "type": "visible_tests"
        },
        {
          "type": "no_commit"
        }
      ]
    },
    {
      "id": "code-by-plan",
      "title": "按计划实施：验收测试通过",
      "overlays": [
        {
          "name": "order-filter-plan",
          "mode": "base"
        }
      ],
      "prompt": "/code-by-plan 按 .ai-configs/plan/2026/10/2026-10-order-filter-订单状态筛选-编码计划.md 实施",
      "expect_skills": [
        "code-by-plan"
      ],
      "checks": [
        {
          "type": "hidden_tests",
          "file": "order-filter.test.js"
        },
        {
          "type": "visible_tests"
        },
        {
          "type": "changed_within",
          "paths": [
            "src/orders.js",
            "test/",
            ".ai-configs/"
          ]
        },
        {
          "type": "no_commit"
        }
      ]
    },
    {
      "id": "create-plan",
      "title": "写计划：找全分散的状态读取方，不编估算，不另立收尾验证任务",
      "overlays": [
        {
          "name": "order-cancel",
          "mode": "base"
        },
        {
          "name": "order-cancel-analysis",
          "mode": "base"
        }
      ],
      "prompt": "/create-plan 按 .ai-configs/analysis/2026/10/2026-10-order-cancel-订单取消-需求分析.md 写编码计划",
      "expect_skills": [
        "create-plan"
      ],
      "checks": [
        {
          "type": "artifact_matches",
          "path": "^\\.ai-configs/(plan/.+-编码计划|tasks/[^/]+/plan)\\.md$",
          "pattern": "report\\.js"
        },
        {
          "type": "artifact_matches",
          "path": "^\\.ai-configs/(plan/.+-编码计划|tasks/[^/]+/plan)\\.md$",
          "negate": true,
          "pattern": "((估算|预估|工作量|耗时|预计)[^\\n]{0,40}\\d+(\\.\\d+)?\\s*(小时|人天|人日|工作日|天)|\\d+(\\.\\d+)?\\s*[-~～–到至]\\s*\\d+(\\.\\d+)?\\s*(小时|人天|人日|工作日|天))"
        },
        {
          "type": "artifact_matches",
          "path": "^\\.ai-configs/(plan/.+-编码计划|tasks/[^/]+/plan)\\.md$",
          "negate": true,
          "pattern": "^(#{2,4}|\\s*-\\s*\\[ \\]\\s*\\*\\*)[^\\n]*((最后|最终|整体|全量)[^\\n]*验证|跨任务|端到端|串联)"
        },
        {
          "type": "no_source_change"
        },
        {
          "type": "no_commit"
        }
      ]
    },
    {
      "id": "code-by-plan-stale",
      "title": "计划漏了读取方：执行时核对代码事实，补上营收报表",
      "overlays": [
        {
          "name": "order-cancel",
          "mode": "base"
        },
        {
          "name": "order-cancel-analysis",
          "mode": "base"
        },
        {
          "name": "order-cancel-plan",
          "mode": "base"
        }
      ],
      "prompt": "/code-by-plan 按 .ai-configs/plan/2026/10/2026-10-order-cancel-订单取消-编码计划.md 实施",
      "expect_skills": [
        "code-by-plan"
      ],
      "checks": [
        {
          "type": "hidden_tests",
          "file": "order-cancel.test.js"
        },
        {
          "type": "visible_tests"
        },
        {
          "type": "changed_within",
          "paths": [
            "src/",
            "test/",
            ".ai-configs/"
          ]
        },
        {
          "type": "no_commit"
        }
      ]
    },
    {
      "id": "bug-fix",
      "title": "修复满减券：修到根因，只动相关文件",
      "prompt": "/bug-fix 购物车满减券不生效：满 100 减 20 的券，买 120 元的商品结算还是 120 元",
      "expect_skills": [
        "bug-fix"
      ],
      "checks": [
        {
          "type": "hidden_tests",
          "file": "cart-coupon.test.js"
        },
        {
          "type": "visible_tests"
        },
        {
          "type": "changed_within",
          "paths": [
            "src/cart.js",
            "test/",
            ".ai-configs/"
          ]
        },
        {
          "type": "no_commit"
        }
      ]
    },
    {
      "id": "review",
      "title": "审查提交：指出退款没有校验订单状态",
      "overlays": [
        {
          "name": "refund-commit",
          "mode": "commit",
          "message": "feat: 订单退款"
        }
      ],
      "prompt": "/review 审查最近一次提交",
      "expect_skills": [
        "review"
      ],
      "checks": [
        {
          "type": "output_matches",
          "pattern": "(重复退款|多次退款|再次退款|已退款|未支付|待支付|pending|refunded|状态(校验|检查|判断))"
        },
        {
          "type": "no_source_change"
        },
        {
          "type": "no_commit"
        }
      ]
    },
    {
      "id": "claim-check",
      "title": "完成声明：有测试失败时不能说可以交付",
      "overlays": [
        {
          "name": "thousands-worktree",
          "mode": "worktree"
        }
      ],
      "prompt": "/harness 只核对「价格千分位改完了，相关测试通过」这一条完成声明的证据。把核对结果留档。",
      "expect_skills": [
        "harness"
      ],
      "checks": [
        {
          "type": "ran_command",
          "pattern": "(npm (run )?test|node --test)"
        },
        {
          "type": "output_matches",
          "pattern": "(未通过|失败|不通过|fail|不能交付|不可交付|尚未完成|未完成)"
        },
        {
          "type": "artifact_matches",
          "path": "^\\.ai-configs/(?:verification/.*|tasks/[^/]+/verification)\\.md$",
          "pattern": "千分位"
        }
      ]
    },
    {
      "id": "harness-acceptance",
      "title": "交付验收：实现者说改好了也要核对目标和回归",
      "overlays": [
        {
          "name": "thousands-worktree",
          "mode": "worktree"
        }
      ],
      "prompt": "/harness 价格千分位已经改好了。请做上线前验收：1234567.5 要显示为 ¥1,234,567.50，负数符号在 ¥ 前，检查已有行为有没有回归。把验收结论留档。",
      "expect_skills": [
        "harness"
      ],
      "checks": [
        {
          "type": "ran_command",
          "pattern": "(npm (run )?test|node --test)"
        },
        {
          "type": "artifact_matches",
          "path": "^\\.ai-configs/(?:harness/.*|tasks/[^/]+/harness)\\.md$",
          "pattern": "回归"
        },
        {
          "type": "output_matches",
          "pattern": "(未通过|失败|不通过|fail|不能交付|不可交付|修复后交付|需要重做)"
        }
      ]
    }
  ]
}
